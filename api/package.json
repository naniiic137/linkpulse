{
  "name": "@linkpulse/api",
  "version": "1.0.0",
  "private": true,
  "description": "LinkPulse API: URL shortener with real-time analytics (Fastify + TypeScript).",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/stores/postgres/migrations','dist/stores/postgres/migrations',{recursive:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "loadtest": "tsx bench/redirect-loadtest.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/jwt": "^10.2.2",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@node-rs/argon2": "^2.2.1",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1",
    "isbot": "^5.2.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "ua-parser-js": "^1.0.41"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/ua-parser-js": "^0.7.39",
    "autocannon": "^8.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^4.1.11"
  }
}
