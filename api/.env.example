# Copy to .env (optional). Every value has a sensible default for local dev.
PORT=3501
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:3501
WEB_ORIGIN=http://localhost:3502

# memory (default, no Docker needed) | postgres (requires DATABASE_URL + REDIS_URL)
STORE=memory
DATABASE_URL=postgres://linkpulse:linkpulse@localhost:5432/linkpulse
REDIS_URL=redis://localhost:6379

# Secrets: CHANGE THESE in any shared environment
JWT_SECRET=dev-only-jwt-secret-change-me-please-32chars
CODE_SECRET=dev-only-code-secret
VISITOR_SALT=dev-only-visitor-salt

REDIRECT_STATUS=302
COUNTRY_HEADER=cf-ipcountry
TRUST_PROXY=false
RATE_LIMITS_ENABLED=true
PREVIEW_FETCH=true
SEED_DEMO=true
LOG_LEVEL=info
